---
import { profile } from '../data/profile';
---

<aside class="profile-sidebar" aria-labelledby="profile-name">
  <img
    class="portrait-image"
    src={profile.portrait.src}
    alt={profile.portrait.alt ?? ''}
    width={profile.portrait.width}
    height={profile.portrait.height}
    decoding="async"
  />

  <div class="profile-introduction">
    <h1 id="profile-name">{profile.name}</h1>
    <p class="profile-role">{profile.title}</p>
    <p>{profile.descriptor}</p>
  </div>

  <p class="profile-status">
    {profile.currentStatus}
    {profile.location && <><br />{profile.location}</>}
  </p>

  <div class="profile-links">
    <h2>Links</h2>
    <ul>
      {
        profile.links.map((link) => (
          <li>
            {link.href ? <a href={link.href}>{link.label}</a> : <span>{link.label} — link placeholder</span>}
          </li>
        ))
      }
    </ul>
  </div>
</aside>

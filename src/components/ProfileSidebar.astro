---
import { profile } from '../data/profile';
---

<aside class="profile-sidebar" aria-labelledby="profile-name">
  <div class="portrait-placeholder" aria-hidden="true">{profile.portrait.placeholder}</div>

  <div class="profile-introduction">
    <h1 id="profile-name">{profile.name}</h1>
    <p class="profile-role">{profile.title}</p>
    <p>{profile.descriptor}</p>
  </div>

  <p class="profile-status">{profile.currentStatus}</p>

  <div class="profile-links" aria-label="Professional links">
    <h2>Links</h2>
    <ul>
      {
        profile.links.map((link) => (
          <li>
            {link.href ? <a href={link.href}>{link.label}</a> : <span>{link.label} — link placeholder</span>}
          </li>
        ))
      }
    </ul>
  </div>
</aside>

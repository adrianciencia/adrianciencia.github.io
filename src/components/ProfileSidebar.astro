---
import { profile } from '../data/profile';
import SocialIcon from './SocialIcon.astro';

interface Props {
  nameAsHeading?: boolean;
}

// The name is the page's h1 on the homepage only; project pages own their h1.
const { nameAsHeading = true } = Astro.props;
const NameTag = nameAsHeading ? 'h1' : 'p';
---

<aside class:list={['profile-sidebar', { 'profile-sidebar-compact': !nameAsHeading }]} aria-labelledby="profile-name">
  <img
    class="portrait-image"
    src={profile.portrait.src}
    srcset={profile.portrait.sources?.map((source) => `${source.src} ${source.width}w`).join(', ')}
    sizes={nameAsHeading ? profile.portrait.sizes : '(max-width: 860px) 3.5rem, 13.75rem'}
    alt={profile.portrait.alt ?? ''}
    width={profile.portrait.width}
    height={profile.portrait.height}
    decoding="async"
  />

  <div class="profile-introduction">
    <NameTag id="profile-name" class="profile-name">
      <span class="name-given">{profile.givenName}</span>{' '}
      <span class="name-surnames">{profile.surnames}</span>
    </NameTag>
    <p class="profile-role">{profile.title}</p>
  </div>

  <p class="profile-bio">{profile.bio}</p>

  <!-- On phones this condenses to one line: credential · location (see global.css). -->
  <p class="profile-status">
    {profile.credential && <span class="profile-credential">{profile.credential}</span>}
    <span class="profile-current">{profile.currentStatus}</span>
    {profile.location && <span class="profile-location">{profile.location}</span>}
  </p>

  <div class="profile-links">
    <h2 class="sr-only">Links</h2>
    <ul class="social-links">
      {
        profile.links.map((link) => (
          <li>
            <a
              class="social-link"
              href={link.href}
              aria-label={link.icon === 'email' ? `Email ${profile.name}` : `${link.label}: ${profile.handle}`}
              title={link.label}
            >
              <SocialIcon name={link.icon} />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="profile-handle">{profile.handle}</p>
  </div>
</aside>

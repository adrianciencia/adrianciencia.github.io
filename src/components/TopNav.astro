---
import { profile } from '../data/profile';

interface Props {
  showWriting: boolean;
  showPhotography: boolean;
}

const { showWriting, showPhotography } = Astro.props;
---

<header class="site-header">
  <nav class="top-nav" aria-label="Primary navigation">
    <a class="wordmark" href="#about">{profile.name}</a>
    <div class="nav-links">
      <a href="#research">Research</a>
      <a href="#building">Building</a>
      {showWriting && <a href="#writing">Writing</a>}
      {showPhotography && <a href="#photography">Photography</a>}
    </div>
  </nav>
</header>

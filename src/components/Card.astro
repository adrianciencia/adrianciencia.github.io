---
interface Props {
  id?: string;
  href: string;
  title: string;
  summary?: string;
  role?: string;
  evidence?: string;
  meta?: string;
  image?: string;
  /** Illustrations fill the frame; figures are shown whole so no labels are cut. */
  imageFit?: 'cover' | 'contain';
  imageCredit?: string;
  lead?: boolean;
}

const { id, href, title, summary, role, evidence, meta, image, imageFit = 'cover', imageCredit, lead = false } =
  Astro.props;
---

<!-- The title link stretches over the whole card, so the card is one click target and one tab stop. -->
<article class:list={['card', { 'card-lead': lead }]} id={id}>
  {
    image && (
      <div class:list={['card-media', `card-media-${imageFit}`]}>
        <img src={image} alt="" width="1600" height="1067" loading="lazy" decoding="async" />
        {imageCredit && <p class="card-credit">{imageCredit}</p>}
      </div>
    )
  }
  <h3 class="card-title">
    <a class="card-link" href={href}>{title}</a>
  </h3>
  {role && <p class="card-role">{role}</p>}
  {summary && <p class="card-summary">{summary}</p>}
  {(evidence || meta) && <p class="card-footer">{evidence ?? meta}</p>}
</article>

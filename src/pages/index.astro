---
import { getCollection } from 'astro:content';
import ProfileSidebar from '../components/ProfileSidebar.astro';
import TopNav from '../components/TopNav.astro';
import { archive } from '../data/archive';
import { building } from '../data/building';
import { community } from '../data/community';
import { photography } from '../data/photography';
import { about, now, profile } from '../data/profile';
import { publications } from '../data/publications';
import { research } from '../data/research';
import '../styles/global.css';

const writingEntries = (await getCollection('writing'))
  .filter((entry) => !entry.data.draft)
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
const showWriting = writingEntries.length > 0;
const showPhotography = photography.length > 0;
const canonicalUrl = 'https://adrianciencia.github.io/';
const siteDescription =
  'Observational astrophysicist studying high-redshift galaxy evolution, spectroscopy, and scientific inference.';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  url: canonicalUrl,
  jobTitle: profile.title,
  sameAs: ['https://github.com/adrianciencia', 'https://www.linkedin.com/in/adrianciencia'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={siteDescription}
    />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.name} — Astrophysicist`} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${profile.name} — Astrophysicist`} />
    <meta name="twitter:description" content={siteDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{profile.name} — Astrophysicist</title>
  </head>
  <body>
    <TopNav showWriting={showWriting} showPhotography={showPhotography} />

    <main class="site-layout">
      <ProfileSidebar />

      <div class="document-column">
        <section id="about" aria-labelledby="about-heading">
          <p class="section-label">About</p>
          <h2 id="about-heading" class="sr-only">About</h2>
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </section>

        <section id="now" aria-labelledby="now-heading" class="section-compact">
          <p class="section-label">Now</p>
          <h2 id="now-heading" class="sr-only">Now</h2>
          <div class="now-list">
            {
              now.items.map((item) => (
                <article class="now-item">
                  <p class="now-item-label">{item.label}</p>
                  <p class="now-note">{item.text}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section id="research" aria-labelledby="research-heading" class="section-research">
          <p class="section-label">Research</p>
          <h2 id="research-heading">Selected research</h2>
          <div class="research-items">
            {
              research.map((item) => (
                <article class="research-item" id={item.id}>
                  <figure class="research-media">
                    <img
                      class="research-figure"
                      src={item.figure.src}
                      alt={item.figure.alt ?? ''}
                      width={item.figure.width}
                      height={item.figure.height}
                      loading="lazy"
                      decoding="async"
                    />
                    {
                      item.figure.src && (
                        <a class="research-figure-link" href={item.figure.src}>
                          Open full figure <span aria-hidden="true">↗</span>
                        </a>
                      )
                    }
                  </figure>
                  <div class="research-copy">
                    <h3>{item.title}</h3>
                    <p class="research-question">{item.question}</p>
                    <p class="research-summary">{item.summary}</p>
                    {item.status && <p class="research-status">{item.status}</p>}
                    {
                      item.artifacts.some((artifact) => artifact.href) && (
                        <p class="artifact-labels">
                          {
                            item.artifacts.map((artifact) =>
                              artifact.href && <a href={artifact.href}>{artifact.label}</a>,
                            )
                          }
                        </p>
                      )
                    }
                  </div>
                </article>
              ))
            }
          </div>

          {
            publications.length > 0 && (
              <div class="publications-placeholder">
                <h3>Selected publications</h3>
                <ol class="publication-list">
                  {
                    publications.map((publication) => (
                      <li>
                        <div>
                          <strong>{publication.title}</strong>
                          <span>{publication.authors}</span>
                        </div>
                        <span>{publication.year}</span>
                      </li>
                    ))
                  }
                </ol>
              </div>
            )
          }
        </section>

        <section id="community" aria-labelledby="community-heading">
          <p class="section-label">Community</p>
          <h2 id="community-heading">Community &amp; Public Science</h2>
          <ul class="editorial-list editorial-list-detailed community-list">
            {
              community.map((item) => (
                <li>
                  <div>
                    <strong>{item.title}</strong>
                    {item.role && <p class="editorial-item-role">{item.role}</p>}
                    <p class="editorial-item-description">{item.description}</p>
                  </div>
                  {item.period && <span>{item.period}</span>}
                </li>
              ))
            }
          </ul>
        </section>

        <section id="building" aria-labelledby="building-heading">
          <p class="section-label">Building</p>
          <h2 id="building-heading" class="sr-only">Building</h2>
          <ul class="editorial-list editorial-list-detailed">
            {
              building.map((item) => (
                <li>
                  <div>
                    <strong>{item.title}</strong>
                    {item.role && <p class="editorial-item-role">{item.role}</p>}
                    <p class="editorial-item-description">{item.description}</p>
                    {item.evidence && <p class="editorial-item-evidence">{item.evidence}</p>}
                  </div>
                  {item.period && <span>{item.period}</span>}
                </li>
              ))
            }
          </ul>
        </section>

        {
          showWriting && (
            <section id="writing" aria-labelledby="writing-heading">
              <p class="section-label">Writing</p>
              <h2 id="writing-heading">Selected writing</h2>
              <ul class="editorial-list editorial-list-writing">
                {
                  writingEntries.map((entry) => (
                    <li>
                      <div>
                        <strong>{entry.data.title}</strong>
                        <p>{entry.data.summary}</p>
                      </div>
                      <span>{entry.data.date.getFullYear()}</span>
                    </li>
                  ))
                }
              </ul>
            </section>
          )
        }

        {
          showPhotography && (
            <section id="photography" aria-labelledby="photography-heading">
              <p class="section-label">Photography</p>
              <h2 id="photography-heading">Selected photography</h2>
              <div class="gallery-placeholder">
                {photography.map((item) => (
                  <span>{item.caption ?? item.placeholder}</span>
                ))}
              </div>
            </section>
          )
        }

        <section id="archive" aria-labelledby="archive-heading" class="section-archive">
          <p class="section-label">Archive</p>
          <h2 id="archive-heading">Selected earlier work</h2>
          <dl class="archive-list">
            {
              archive.map((item) => (
                <div>
                  <dt>{item.period}</dt>
                  <dd>
                    {item.title && <strong class="archive-item-title">{item.title}</strong>}
                    <p class="archive-item-description">{item.description}</p>
                    {
                      item.link?.href && (
                        <a class="archive-item-link" href={item.link.href}>{item.link.label}</a>
                      )
                    }
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <footer class="site-footer">
          <p>© 2026 Adrian Díaz Espinoza</p>
        </footer>
      </div>
    </main>
  </body>
</html>

---
import { getCollection } from 'astro:content';
import Card from '../components/Card.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { photography } from '../data/photography';
import { profile } from '../data/profile';
import { research } from '../data/research';
import { findResearchCover, publicAssetExists, responsiveSrcset } from '../lib/assets';
import { datedLine, formatMonth, getNews } from '../lib/news';

const writingEntries = (await getCollection('writing'))
  .filter((entry) => !entry.data.draft)
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());
const showWriting = writingEntries.length > 0;
const showPhotography = photography.length > 0;

const byOrder = (first: { data: { order: number } }, second: { data: { order: number } }) =>
  first.data.order - second.data.order;
const communityEntries = (await getCollection('community')).sort(byOrder);
const workEntries = (await getCollection('work')).sort(byOrder);
// Derívate (first by order) leads only once it carries an evidence line; until then all four sit 2×2.
const communityHasLead = Boolean(communityEntries[0]?.data.evidence);
const workIsDated = workEntries.some((entry) => entry.data.year);

const { featured, list: newsList } = await getNews();
const featuredImage =
  featured?.data.image && publicAssetExists(featured.data.image) ? featured.data.image : undefined;

const researchCards = research.map((item) => {
  const cover = findResearchCover(item.id);
  return {
    item,
    // An illustration when there is one; otherwise the result as a number, and the figure only as a last resort.
    image: cover ?? (item.keyFigure ? undefined : (item.figure.sources?.[0]?.src ?? item.figure.src)),
    imageFit: cover ? ('cover' as const) : ('contain' as const),
    imageCredit: cover ? 'Illustration' : undefined,
    imageSrcset: cover ? responsiveSrcset(cover) : undefined,
    stat: item.keyFigure,
  };
});

const siteDescription =
  'Observational astrophysicist studying high-redshift galaxy evolution, spectroscopy, and scientific inference.';
// Search engines and LLMs read this to tie the name, its unaccented spelling and the social profiles to one person.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://adrianciencia.github.io/#person',
  name: profile.name,
  alternateName: ['Adrian Diaz Espinoza', profile.handle],
  givenName: profile.givenName,
  familyName: profile.surnames,
  url: 'https://adrianciencia.github.io/',
  image: new URL(profile.portrait.src, 'https://adrianciencia.github.io').href,
  jobTitle: profile.title,
  description: profile.bio,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Wisconsin–Madison' },
  homeLocation: { '@type': 'Place', name: profile.location },
  knowsAbout: ['High-redshift galaxy evolution', 'JWST', 'Spectroscopy', 'Star formation', 'Scientific inference'],
  sameAs: profile.links.filter((link) => link.icon !== 'email').map((link) => link.href),
};
---

<BaseLayout
  title={`${profile.name} — Astrophysicist`}
  description={siteDescription}
  path="/"
  shareImage={profile.portrait.src}
  jsonLd={personSchema}
>
  {
    (featured || newsList.length > 0) && (
      <section id="news" aria-labelledby="news-heading" class="section-news">
        <h2 id="news-heading">News</h2>
        {
          featured && (
            <article class:list={['featured-item', 'card', { 'featured-item-with-image': featuredImage }]} id={`news-${featured.id}`}>
              {
                featuredImage && (
                  <img
                    class="featured-image"
                    src={featuredImage}
                    srcset={responsiveSrcset(featuredImage)}
                    sizes="(max-width: 560px) calc(100vw - 2rem), 28rem"
                    alt={featured.data.imageAlt}
                    width="1600"
                    height="1067"
                    decoding="async"
                  />
                )
              }
              <div class="featured-body">
                <h3>
                  <a class="card-link" href={`/news/${featured.id}/`}>
                    {featured.data.title}
                  </a>
                </h3>
                <p class="featured-meta">
                  <time datetime={featured.data.date.toISOString().slice(0, 10)}>{datedLine(featured.data)}</time>
                  {
                    (featured.data.format || featured.data.location) && (
                      <span class="featured-meta-rest">
                        {[featured.data.format, featured.data.location].filter(Boolean).join(' · ')}
                      </span>
                    )
                  }
                </p>
                <p class="card-summary">{featured.data.summary}</p>
              </div>
            </article>
          )
        }
        {
          newsList.length > 0 && (
            <ul class="news-list">
              {
                newsList.map((entry) => (
                  <li>
                    <time class="news-date" datetime={entry.data.date.toISOString().slice(0, 10)}>
                      {formatMonth(entry.data.date)}
                    </time>
                    <div>
                      <a class="news-title" href={`/news/${entry.id}/`}>
                        {entry.data.title}
                      </a>
                      <p>{entry.data.summary}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          )
        }
      </section>
    )
  }

  <section id="research" aria-labelledby="research-heading" class="section-research">
    <h2 id="research-heading">Research</h2>
    <div class="card-grid">
      {
        researchCards.map(({ item, image, imageFit, imageCredit, imageSrcset, stat }) => (
          <Card
            id={`research-${item.id}`}
            href={`/research/${item.id}/`}
            title={item.title}
            summary={item.takeaway}
            meta={item.status}
            image={image}
            imageFit={imageFit}
            imageCredit={imageCredit}
            imageSrcset={imageSrcset}
            stat={stat}
          />
        ))
      }
    </div>
  </section>

  <section id="community" aria-labelledby="community-heading" class="section-community">
    <h2 id="community-heading">Community &amp; Public Science</h2>
    <div class:list={['card-grid', { 'card-grid-with-lead': communityHasLead }]}>
      {
        communityEntries.map((entry, index) => (
          <Card
            id={`community-${entry.id}`}
            href={`/community/${entry.id}/`}
            title={entry.data.title}
            role={entry.data.role}
            summary={entry.data.summary}
            evidence={entry.data.evidence}
            lead={communityHasLead && index === 0}
          />
        ))
      }
    </div>
  </section>

  {
    showWriting && (
      <section id="writing" aria-labelledby="writing-heading">
        <h2 id="writing-heading">Selected writing</h2>
        <ul class="editorial-list editorial-list-writing">
          {
            writingEntries.map((entry) => (
              <li>
                <div>
                  <strong>{entry.data.title}</strong>
                  <p>{entry.data.summary}</p>
                </div>
                <span>{entry.data.date.getFullYear()}</span>
              </li>
            ))
          }
        </ul>
      </section>
    )
  }

  {
    showPhotography && (
      <section id="photography" aria-labelledby="photography-heading">
        <h2 id="photography-heading">Selected photography</h2>
        <div class="gallery-placeholder">
          {photography.map((item) => (
            <span>{item.caption ?? item.placeholder}</span>
          ))}
        </div>
      </section>
    )
  }

  <section id="other-work" aria-labelledby="other-work-heading" class="section-other">
    <h2 id="other-work-heading">Other work</h2>
    <ul class:list={['work-list', { 'work-list-dated': workIsDated }]}>
      {
        workEntries.map((entry) => (
          <li class="work-row" id={`work-${entry.id}`}>
            {workIsDated && <span class="work-year">{entry.data.year}</span>}
            <div>
              <a class="work-title" href={`/work/${entry.id}/`}>
                {entry.data.title}
              </a>
              {entry.data.role && <p class="work-role">{entry.data.role}</p>}
              {entry.data.summary && <p class="work-summary">{entry.data.summary}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

</BaseLayout>

---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryPage from '../../components/EntryPage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const entries = (await getCollection('community')).sort((first, second) => first.data.order - second.data.order);
  return entries.map((entry, index) => ({
    params: { id: entry.id },
    props: { entry, previous: entries[index - 1], next: entries[index + 1] },
  }));
}

type Entry = CollectionEntry<'community'>;

interface Props {
  entry: Entry;
  previous?: Entry;
  next?: Entry;
}

const { entry, previous, next } = Astro.props;
const neighbour = (item?: Entry) => item && { href: `/community/${item.id}/`, title: item.data.title };
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title} — ${profile.name}`}
  description={entry.data.summary ?? entry.data.title}
  path={`/community/${entry.id}/`}
  nameAsHeading={false}
  section="community"
>
  <EntryPage
    backHref={`/#community-${entry.id}`}
    backLabel="Community & Public Science"
    title={entry.data.title}
    meta={[entry.data.role ?? '']}
    link={entry.data.link}
    previous={neighbour(previous)}
    next={neighbour(next)}
  >
    <Content />
  </EntryPage>
</BaseLayout>

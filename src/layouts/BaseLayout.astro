---
import ProfileSidebar from '../components/ProfileSidebar.astro';
import TopNav from '../components/TopNav.astro';
import { contact, profile } from '../data/profile';
import '../styles/global.css';

// Cookieless page counts (goatcounter.com). The one script on the site; production builds only.
const goatcounterCode = 'adrianciencia';

interface Props {
  title: string;
  description: string;
  path: string;
  nameAsHeading?: boolean;
  /** The homepage section this page belongs to; the nav marks it as current. */
  section?: 'news' | 'research' | 'community' | 'work';
  /** Site-root path of the image shown when the page is shared. */
  shareImage?: string;
  /** Pages with their own closing contact (events) end on the © line only. */
  footerInvitation?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  path,
  nameAsHeading = true,
  section,
  shareImage,
  footerInvitation = true,
  jsonLd,
} = Astro.props;
const shareImageUrl = shareImage ? new URL(shareImage, Astro.site).href : undefined;
const canonicalUrl = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="google-site-verification" content="nnMhWTjZkhEYESbshiQ_tSRkypXiHv_SZbna5f7uuQg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={profile.name} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <TopNav current={section} isHome={nameAsHeading} />

    <main class="site-layout">
      <ProfileSidebar nameAsHeading={nameAsHeading} />

      <div class="document-column" id="content" tabindex="-1">
        <slot />

        <footer class="site-footer" id="contact">
          {
            footerInvitation && (
              <p class="footer-invitation">
                {contact.invitation} <a href={`mailto:${contact.email}`}>{contact.email}</a>
              </p>
            )
          }
          <p>
            © {new Date().getFullYear()} {profile.givenName}{' '}<span class="name-surnames">{profile.surnames}</span>
          </p>
        </footer>
      </div>
    </main>
  </body>
</html>
